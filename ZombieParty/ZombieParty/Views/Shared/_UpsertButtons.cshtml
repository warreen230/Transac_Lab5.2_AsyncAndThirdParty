@model int
<div class="col">
    @if (Model == 0)
    {
        <button type="submit" class="btn btn-success w-100"><i class="fas fa-plus-square"></i>&nbsp;Create</button>
    }
    else
    {
        <button type="submit" class="btn btn-info w-100" value="Edit"><i class="fa-solid fa-pen-to-square"></i>Edit </button>
    }
</div>
<div class="col">
    <a class="btn btn-success" asp-action="Upsert"><i class="fas fa-plus-square"></i>&nbsp;Create New</a>
</div>
